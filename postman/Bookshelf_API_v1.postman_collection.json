          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 403', () => pm.response.to.have.status(403));", "pm.test('日本語の認可エラー', () => pm.expect(pm.response.json()).to.eql({error: 'この操作を実行する権限がありません。'}));"] } }]
        },
        {
          "name": "DELETE 非所有者 [403]",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{otherUserBearerToken}}", "type": "string" }] },
            "method": "DELETE",
